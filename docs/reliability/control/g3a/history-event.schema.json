{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divergence.ai/control/g3a/history-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "sequence", "repository_id", "task", "attempt", "from", "to", "candidate_sha", "actor_principal", "policy_version", "timestamp", "previous_event_digest"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "repository_id": { "type": "integer", "minimum": 1 },
    "task": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "from": { "type": ["string", "null"] },
    "to": { "type": "string", "minLength": 1 },
    "candidate_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "actor_principal": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "evidence_digest": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "previous_event_digest": { "type": ["string", "null"] }
  }
}
