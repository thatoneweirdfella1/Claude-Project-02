{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divergence.ai/control/g3a/correction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["correction_id", "task", "attempt", "failed_attestation_id", "failed_candidate_sha", "defects", "acceptance_tests", "state"],
  "properties": {
    "correction_id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 2 },
    "failed_attestation_id": { "type": "string", "minLength": 1 },
    "failed_candidate_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "defects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "acceptance_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "state": { "const": "Open" },
    "assigned_worker_principal": { "type": ["string", "null"] }
  }
}
