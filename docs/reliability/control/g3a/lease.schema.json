{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divergence.ai/control/g3a/lease.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lease_id", "repository_id", "task", "attempt", "worker_principal", "base_sha", "issued_at", "heartbeat_at", "expires_at", "allowed_paths"],
  "properties": {
    "lease_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "integer", "minimum": 1 },
    "task": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "worker_principal": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
