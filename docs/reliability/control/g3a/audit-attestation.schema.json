{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divergence.ai/control/g3a/audit-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "repository_id", "task", "attempt", "base_sha", "candidate_sha", "author_principal", "auditor_principal", "audit_policy_version", "evidence_digest", "verdict", "timestamp", "host_signature"],
  "properties": {
    "attestation_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "integer", "minimum": 1 },
    "task": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "author_principal": { "type": "string", "minLength": 1 },
    "auditor_principal": { "type": "string", "minLength": 1 },
    "audit_policy_version": { "type": "string", "minLength": 1 },
    "evidence_digest": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["Independently verified", "Failed"] },
    "defects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "timestamp": { "type": "string", "format": "date-time" },
    "host_signature": { "type": "string", "minLength": 1 }
  }
}
