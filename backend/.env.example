ANTHROPIC_API_KEY=sk-ant-v0-...
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...

DATABASE_PATH=./app.db
DATABASE_URL=sqlite:///./app.db

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

HOST=0.0.0.0
PORT=8000
DEBUG=false

ENABLE_EXTENDED_THINKING=true
